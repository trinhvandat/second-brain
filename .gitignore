.DS_Store
.omc/
*.tmp
node_modules/
.env
.idea/
.lint-history.log

# Quartz site (generated / installed artifacts)
# NOTE: site/content/ is generated by scripts/build-site.sh but is intentionally
# NOT listed here — Quartz's build globs with `gitignore: true`, so a committed
# ignore of content/ makes it skip every note. It is kept out of `git status`
# via a local .git/info/exclude entry that build-site.sh maintains instead.
site/node_modules/
site/public/
site/.quartz-cache/
site/.quartz/
